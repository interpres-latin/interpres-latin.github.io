# Optional. Defaults to 4000.
# PORT=4000

# Where the translator's problem reports are appended. Defaults to logs/ in the
# checkout, which is gitignored. Point it at a mounted disk in production, or
# the file goes with the next deploy.
# REPORT_LOG_DIR=/var/data/interpres

# Pronunciation on the dictionary page, from ElevenLabs. The free tier is
# 10,000 characters a month for the whole site, so clips are cached and only
# single words are spoken. Without a key the speaker button removes itself.
# The key needs the text_to_speech permission; a free account cannot use voices
# from the voice library, so the default voice is a premade one.
#
# No speech model has Latin. It is spoken with Italian phonology, which is
# closer to church Latin than to the classical pronunciation a Cambridge course
# teaches, and the page says so beside the button.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=Xb7hH8MSUJpSbSDYk0k2

# Set only when the app really is behind a proxy you control. It makes the
# report log's rate limit trust X-Forwarded-For, which any client can send.
# TRUST_PROXY=1

# --- Language model ----------------------------------------------------------
#
# Not on the critical path for anything. Translation is this site's own code
# from end to end and never touches a model; so are the conjugator, the decliner
# and the dictionary's definitions. A model is reached for two things only: a
# Latin question the site's own data cannot answer, and the dictionary's example
# sentences when no corpus sentence exists. Without a key everything else still
# works.

# Free. https://console.groq.com/keys
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# Paid. https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# Force one instead of auto-detecting: groq | anthropic
# LLM_PROVIDER=groq
